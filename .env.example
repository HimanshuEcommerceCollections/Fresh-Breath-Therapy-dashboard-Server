SECRET_KEY=
DATABASE_URL=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# "development" enables /docs, /redoc and /openapi.json. ANY other value —
# including leaving this unset — disables all three, because the schema
# document describes every PHI field the API returns and must not be public.
# Set this to development locally; leave it out (or set production) on deploys.
ENVIRONMENT=development
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated Workspace domains allowed to sign in with Google. Leave
# empty and ANY Google account can reach the pending-approval queue.
ALLOWED_GOOGLE_DOMAINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_URL=
ALLOWED_ORIGINS=http://localhost:3000,https://fresh-breath-therapy-dashboard-ui.vercel.app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=<the 16-character app password>
SMTP_FROM_EMAIL=your-email@gmail.com
# REQUIRED, no default. Decides whether a second factor exists at all; the app
# refuses to start without it. true needs working SMTP or nobody can log in.
EMAIL_SERVICE=false
LEAD_WEBHOOK_SECRET=
CRON_SECRET=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_ECHO=
DB_POOL_PRE_PING=
